{
  "title": "votes-<hash8>.json, schema v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "snapshotId": {
      "type": "string",
      "minLength": 1
    },
    "rosters": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rollCalls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "billId": {
            "type": "string",
            "minLength": 1
          },
          "house": {
            "type": "string",
            "enum": [
              "A",
              "S"
            ]
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "time": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{2}:\\d{2}:\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "third_reading",
              "consent",
              "concurrence"
            ]
          },
          "fileLocation": {
            "type": [
              "string",
              "null"
            ]
          },
          "motionText": {
            "type": "string"
          },
          "ayes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "noes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "noVoteRecorded": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "result": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL"
            ]
          },
          "tallyMatches": {
            "type": "boolean"
          },
          "versionId": {
            "type": "string",
            "minLength": 1
          },
          "versionInferred": {
            "type": "boolean"
          },
          "final": {
            "type": "boolean"
          },
          "v": {
            "type": "string",
            "pattern": "^[ANX-]*$"
          },
          "src": {
            "type": "object",
            "properties": {
              "table": {
                "type": "string",
                "const": "BILL_SUMMARY_VOTE_TBL"
              },
              "billId": {
                "type": "string",
                "minLength": 1
              },
              "locationCode": {
                "type": "string",
                "minLength": 1
              },
              "voteDateTime": {
                "type": "string",
                "minLength": 1
              },
              "voteDateSeq": {
                "type": "string",
                "minLength": 1
              },
              "motionId": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "table",
              "billId",
              "locationCode",
              "voteDateTime",
              "voteDateSeq",
              "motionId"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "billId",
          "house",
          "date",
          "time",
          "kind",
          "fileLocation",
          "motionText",
          "ayes",
          "noes",
          "noVoteRecorded",
          "result",
          "tallyMatches",
          "versionId",
          "versionInferred",
          "final",
          "v",
          "src"
        ],
        "additionalProperties": false
      }
    },
    "noRollCall": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "billId": {
            "type": "string",
            "minLength": 1
          },
          "house": {
            "type": "string",
            "enum": [
              "A",
              "S"
            ]
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "historyAction": {
            "type": "string",
            "minLength": 1
          },
          "src": {
            "type": "object",
            "properties": {
              "table": {
                "type": "string",
                "const": "BILL_HISTORY_TBL"
              },
              "billId": {
                "type": "string",
                "minLength": 1
              },
              "billHistoryId": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "table",
              "billId",
              "billHistoryId"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "billId",
          "house",
          "date",
          "historyAction",
          "src"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "snapshotId",
    "rosters",
    "rollCalls",
    "noRollCall"
  ],
  "additionalProperties": false
}
