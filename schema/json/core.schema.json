{
  "title": "core-<hash8>.json, schema v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "snapshotId": {
      "type": "string",
      "minLength": 1
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "current",
              "ended"
            ]
          },
          "endDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": [
          "id",
          "label",
          "status",
          "endDate"
        ],
        "additionalProperties": false
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "n": {
            "type": "integer",
            "minimum": 1,
            "maximum": 63
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "n",
          "name"
        ],
        "additionalProperties": false
      }
    },
    "committees": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "session": {
            "type": "string",
            "minLength": 1
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "house": {
            "type": "string",
            "enum": [
              "A",
              "S"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "issueId": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "session",
          "code",
          "house",
          "name",
          "issueId"
        ],
        "additionalProperties": false
      }
    },
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "terms": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "session": {
                  "type": "string",
                  "minLength": 1
                },
                "house": {
                  "type": "string",
                  "enum": [
                    "A",
                    "S"
                  ]
                },
                "district": {
                  "type": "string",
                  "minLength": 1
                },
                "voteNames": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "displayName": {
                  "type": "string",
                  "minLength": 1
                },
                "party": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "seated": {
                  "type": "boolean"
                },
                "src": {
                  "type": "object",
                  "properties": {
                    "table": {
                      "type": "string",
                      "const": "LEGISLATOR_TBL"
                    },
                    "district": {
                      "type": "string",
                      "minLength": 1
                    },
                    "legislatorName": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "table",
                    "district",
                    "legislatorName"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "session",
                "house",
                "district",
                "voteNames",
                "displayName",
                "party",
                "seated",
                "src"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "terms"
        ],
        "additionalProperties": false
      }
    },
    "bills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "session": {
            "type": "string",
            "minLength": 1
          },
          "sessionNum": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "AB",
              "SB",
              "ACA",
              "SCA"
            ]
          },
          "num": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "leadAuthors": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "house": {
            "type": "string",
            "enum": [
              "A",
              "S"
            ]
          },
          "status": {
            "type": "string"
          },
          "stage": {
            "type": "string",
            "enum": [
              "floor",
              "passed_house",
              "cleared_committee",
              "hearing_scheduled",
              "introduced",
              "finished"
            ]
          },
          "stageRank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "outcome": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "chaptered",
                  "vetoed",
                  "failed",
                  "died",
                  "session_ended"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "chapter": {
            "type": [
              "string",
              "null"
            ]
          },
          "lastActionDate": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "lastAction": {
            "type": [
              "string",
              "null"
            ]
          },
          "nextHearing": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "committees": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "issueIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "versions": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "num": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "date": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "action": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "num",
                "date",
                "action"
              ],
              "additionalProperties": false
            }
          },
          "latestVersionId": {
            "type": "string",
            "minLength": 1
          },
          "hasDigest": {
            "type": "boolean"
          },
          "analysisShard": {
            "type": [
              "string",
              "null"
            ]
          },
          "src": {
            "type": "object",
            "properties": {
              "table": {
                "type": "string",
                "const": "BILL_TBL"
              },
              "billId": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "table",
              "billId"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "session",
          "sessionNum",
          "type",
          "num",
          "label",
          "title",
          "leadAuthors",
          "house",
          "status",
          "stage",
          "stageRank",
          "outcome",
          "chapter",
          "lastActionDate",
          "lastAction",
          "nextHearing",
          "committees",
          "issueIds",
          "versions",
          "latestVersionId",
          "hasDigest",
          "analysisShard",
          "src"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "snapshotId",
    "sessions",
    "issues",
    "committees",
    "people",
    "bills"
  ],
  "additionalProperties": false
}
