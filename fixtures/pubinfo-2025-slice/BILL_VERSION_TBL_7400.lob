<caml:Description xmlns="http://www.w3.org/1999/xhtml"><caml:Id>20250ACA_000895CHP</caml:Id><caml:VersionNum>95</caml:VersionNum><caml:History><caml:Action><caml:ActionText>INTRODUCED</caml:ActionText><caml:ActionDate>2025-02-20</caml:ActionDate></caml:Action><caml:Action><caml:ActionText>AMENDED_ASSEMBLY</caml:ActionText><caml:ActionDate>2025-08-18</caml:ActionDate></caml:Action><caml:Action><caml:ActionText>AMENDED_ASSEMBLY</caml:ActionText><caml:ActionDate>2025-08-21</caml:ActionDate></caml:Action><caml:Action><caml:ActionText>PASSED_ASSEMBLY</caml:ActionText><caml:ActionDate>2025-08-21</caml:ActionDate></caml:Action><caml:Action><caml:ActionText>PASSED_SENATE</caml:ActionText><caml:ActionDate>2025-08-21</caml:ActionDate></caml:Action><caml:Action><caml:ActionText>ENROLLED</caml:ActionText><caml:ActionDate>2025-08-21</caml:ActionDate></caml:Action><caml:Action><caml:ActionText>CHAPTERED</caml:ActionText><caml:ActionDate>2025-08-21</caml:ActionDate></caml:Action><caml:Action><caml:ActionText>FILED</caml:ActionText><caml:ActionDate>2025-08-21</caml:ActionDate></caml:Action></caml:History><caml:LegislativeInfo><caml:SessionYear>2025</caml:SessionYear><caml:SessionNum>0</caml:SessionNum><caml:MeasureType>ACA</caml:MeasureType><caml:MeasureNum>8</caml:MeasureNum><caml:MeasureState>CHP</caml:MeasureState><caml:ChapterYear>2025</caml:ChapterYear><caml:ChapterType>CHR</caml:ChapterType><caml:ChapterSessionNum>0</caml:ChapterSessionNum><caml:ChapterNum>156</caml:ChapterNum></caml:LegislativeInfo><caml:AuthorText authorType="LEAD_AUTHOR">Introduced by Assembly Member Rivas and Senator McGuire</caml:AuthorText><caml:AuthorText authorType="COAUTHOR_ORIGINATING">(Coauthors: Assembly Members Addis, Aguiar-Curry, Ahrens, Ávila Farías, Bauer-Kahan, Bennett, Berman, Bonta, Bryan, Caloza, Carrillo, Connolly, Elhawary, Fong, Garcia, Gipson, Mark González, Haney, Harabedian, Hart, Jackson, Kalra, Lowenthal, McKinnor, Muratsuchi, Nguyen, Ortega, Pacheco, Pellerin, Petrie-Norris, Quirk-Silva, Ransom, Celeste Rodriguez, Michelle Rodriguez, Rogers, Blanca Rubio, Stefani, Valencia, Ward, Wicks, Wilson, and Zbur)</caml:AuthorText><caml:AuthorText authorType="COAUTHOR_OPPOSITE">(Coauthors: Senators Archuleta, Becker, Cabaldon, Caballero, Cervantes, Cortese, Durazo, Gonzalez, Grayson, Laird, Limón, Padilla, Pérez, Reyes, Stern, Umberg, Wahab, Weber Pierson, and Wiener)</caml:AuthorText><caml:Authors><caml:Legislator><caml:Contribution>LEAD_AUTHOR</caml:Contribution><caml:House>ASSEMBLY</caml:House><caml:Name>Rivas</caml:Name></caml:Legislator><caml:Legislator><caml:Contribution>LEAD_AUTHOR</caml:Contribution><caml:House>SENATE</caml:House><caml:Name>McGuire</caml:Name></caml:Legislator><caml:Legislator><caml:Contribution>COAUTHOR</caml:Contribution><caml:House>ASSEMBLY</caml:House><caml:Name>Addis</caml:Name></caml:Legislator><caml:Legislator><caml:Contribution>COAUTHOR</caml:Contribution><caml:House>ASSEMBLY</caml:House><caml:Name>Aguiar-Curry</caml:Name></caml:Legislator><caml:Legislator><caml:Contribution>COAUTHOR</caml:Contribution><caml:House>ASSEMBLY</caml:House><caml:Name>Ahrens</caml:Name></caml:Legislator><caml:Legislator><caml:Contribution>COAUTHOR</caml:Contribution><caml:House>ASSEMBLY</caml:House><caml:Name>Ávila Farías</caml:Name></caml:Legislator><caml:Legislator><caml:Contribution>COAUTHOR</caml:Contribution><caml:House>ASSEMBLY</caml:House><caml:Name>Bauer-Kahan</caml:Name></caml:Legislator><caml:Legislator><caml:Contribution>COAUTHOR</caml:Contribution><caml:House>ASSEMBLY</caml:House><caml:Name>Bennett</caml:Name></caml:Legislator><caml:Legislator><caml:Contribution>COAUTHOR</caml:Contribution><caml:House>ASSEMBLY</caml:House><caml:Name>Berman</caml:Name></caml:Legislator><caml:Legislator><caml:Contribution>COAUTHOR</caml:Contribution><caml:House>ASSEMBLY</caml:House><caml:Name>Bonta</caml:Name></caml:Legislator><caml:Legislator><caml:Contribution>COAUTHOR</caml:Contribution><caml:House>ASSEMBLY</caml:House><caml:Name>Bryan</caml:Na